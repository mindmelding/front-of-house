<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Front of House sweep, scheduled by launchd. See engine/DURABILITY.md for why this and not an in-session routine.

  Install:  sed "s#REPLACE_ROOT#$HOME/front-of-house#g; s#REPLACE_HOME#$HOME#g" ops/launchd.template.plist \
              > ~/Library/LaunchAgents/com.front-of-house.sweep.plist
            launchctl load ~/Library/LaunchAgents/com.front-of-house.sweep.plist
  Verify:   launchctl list | grep front-of-house      (second column is the last exit code)
  Run now:  launchctl start com.front-of-house.sweep
  Remove:   launchctl unload ~/Library/LaunchAgents/com.front-of-house.sweep.plist

  Not done until it has run once on its own schedule and the SessionStart hook reported it.
  Search for REPLACE_ before loading; a placeholder shipped once.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.front-of-house.sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_ROOT/scripts/sweep.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_ROOT</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>REPLACE_ROOT/overlay/logs/launchd-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_ROOT/overlay/logs/launchd-sweep.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>REPLACE_HOME</string>
  </dict>
</dict>
</plist>
